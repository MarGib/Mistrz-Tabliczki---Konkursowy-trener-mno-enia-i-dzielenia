rules_version = '2';

// Reguły bazy projektu „mistrz-tabliczki” (plan Spark, bez opłat).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidJoinCodeId(code) {
      return code is string && code.size() >= 4 && code.size() <= 16 && code.matches('^[A-Z0-9\\-]+$');
    }

    // Administrator (rodzic): konto Google z dokumentem admins/{uid} — nadawanym ręcznie w konsoli.
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{adminUid} {
      allow get: if isSignedIn() && request.auth.uid == adminUid;
      allow list, write: if false;
    }

    // Dziennik prób logowania (bez haseł) — zapis dla każdego, odczyt tylko dla administratora.
    match /loginEvents/{eventId} {
      allow create: if
        incoming().keys().hasAll(['login', 'ok', 'reason', 'device', 'at']) &&
        incoming().keys().hasOnly(['login', 'ok', 'reason', 'device', 'at']) &&
        incoming().login is string && incoming().login.size() <= 40 &&
        incoming().ok is bool &&
        incoming().reason is string && incoming().reason.size() <= 60 &&
        incoming().device is string && incoming().device.size() <= 20 &&
        incoming().at == request.time;
      allow get, list, delete: if isAdmin();
      allow update: if false;
    }

    // Telemetria dla panelu administratora — zapis dla każdego (ścisły format), odczyt tylko administrator.
    match /devices/{deviceId} {
      allow create, update: if deviceId.size() <= 60 &&
        incoming().keys().hasOnly(['platform', 'browser', 'installed', 'appVersion', 'logins', 'unsent', 'dbPaused', 'firstSeenMs', 'lastSeen']) &&
        incoming().platform is string && incoming().platform.size() <= 30 &&
        incoming().browser is string && incoming().browser.size() <= 30 &&
        incoming().installed is bool &&
        incoming().appVersion is string && incoming().appVersion.size() <= 20 &&
        incoming().logins is list && incoming().logins.size() <= 8 &&
        incoming().unsent is bool && incoming().dbPaused is bool &&
        incoming().firstSeenMs is number &&
        incoming().lastSeen == request.time;
      allow get, list, delete: if isAdmin();
    }

    match /appErrors/{errorId} {
      allow create: if
        incoming().keys().hasOnly(['message', 'stack', 'appVersion', 'platform', 'device', 'at']) &&
        incoming().message is string && incoming().message.size() <= 300 &&
        incoming().stack is string && incoming().stack.size() <= 900 &&
        incoming().appVersion is string && incoming().appVersion.size() <= 20 &&
        incoming().platform is string && incoming().platform.size() <= 30 &&
        incoming().device is string && incoming().device.size() <= 40 &&
        incoming().at == request.time;
      allow get, list, delete: if isAdmin();
      allow update: if false;
    }

    // Komunikat dla wszystkich (pasek / przerwa techniczna) — czyta każdy, zmienia tylko administrator.
    match /config/{docId} {
      allow get: if docId == 'status';
      allow list: if false;
      allow write: if isAdmin() && docId == 'status' &&
        incoming().keys().hasOnly(['mode', 'message', 'untilMs', 'updatedAt']) &&
        incoming().mode in ['off', 'banner', 'maintenance'] &&
        incoming().message is string && incoming().message.size() <= 300 &&
        incoming().untilMs is number;
    }

    match /helpRequests/{requestId} {
      allow create: if
        incoming().keys().hasOnly(['login', 'topic', 'message', 'contact', 'platform', 'device', 'status', 'at']) &&
        incoming().login is string && incoming().login.size() >= 1 && incoming().login.size() <= 40 &&
        incoming().topic in ['password', 'login', 'sync', 'other'] &&
        incoming().message is string && incoming().message.size() <= 500 &&
        incoming().contact is string && incoming().contact.size() <= 80 &&
        incoming().platform is string && incoming().platform.size() <= 30 &&
        incoming().device is string && incoming().device.size() <= 40 &&
        incoming().status == 'new' &&
        incoming().at == request.time;
      allow get, list, delete: if isAdmin();
      allow update: if isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['status']);
    }

    // Uczciwa gra: stan weryfikacji konta. Gracz (jego aplikacja) może tylko ZGŁOSIĆ podejrzenie
    // (watch → pending), nigdy go cofnąć. Zwolnić, zablokować lub oznaczyć jako zaufane może tylko administrator.
    function reviewState(uid) {
      let path = /databases/$(database)/documents/reviews/$(uid);
      return exists(path) ? get(path).data.state : 'none';
    }

    function validReviewEvents(ev) {
      return ev is list && ev.size() <= 20;
    }

    match /reviews/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list, delete: if isAdmin();
      allow create: if (isAdmin() &&
          incoming().state in ['watch', 'pending', 'cleared', 'suspended'] && incoming().trusted is bool) ||
        (isSignedIn() && request.auth.uid == uid &&
        incoming().keys().hasOnly(['uid', 'login', 'state', 'events', 'trusted', 'device', 'createdAt', 'updatedAt']) &&
        incoming().uid == uid &&
        incoming().login is string && incoming().login.size() <= 40 &&
        incoming().state in ['watch', 'pending'] &&
        incoming().trusted == false &&
        validReviewEvents(incoming().events) &&
        incoming().device is string && incoming().device.size() <= 40 &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time);
      allow update: if
        (isAdmin() &&
          incoming().diff(existing()).affectedKeys().hasOnly(['state', 'trusted', 'note', 'decidedAt', 'updatedAt']) &&
          incoming().state in ['watch', 'pending', 'cleared', 'suspended'] &&
          incoming().trusted is bool) ||
        (isSignedIn() && request.auth.uid == uid &&
          existing().trusted != true &&
          existing().state in ['watch', 'pending', 'cleared'] &&
          incoming().diff(existing()).affectedKeys().hasOnly(['state', 'events', 'device', 'updatedAt']) &&
          incoming().state in ['watch', 'pending'] &&
          !(existing().state == 'pending' && incoming().state == 'watch') &&
          validReviewEvents(incoming().events) &&
          incoming().device is string && incoming().device.size() <= 40 &&
          incoming().updatedAt == request.time);
    }

    // 5. Login → identyfikator profilu (potrzebny, by na nowym urządzeniu sprawdzić hasło).
    match /logins/{login} {
      allow get: if login.size() <= 40;
      allow list: if isAdmin();
      allow create: if isSignedIn() && login.size() >= 1 && login.size() <= 40 &&
        incoming().keys().hasAll(['uid', 'profileId', 'createdAt']) &&
        incoming().keys().hasOnly(['uid', 'profileId', 'createdAt']) &&
        incoming().uid == request.auth.uid &&
        incoming().profileId is string && incoming().profileId.size() >= 1 && incoming().profileId.size() <= 64 &&
        incoming().createdAt == request.time;
      allow update: if isSignedIn() && existing().uid == request.auth.uid &&
        incoming().keys().hasOnly(['uid', 'profileId', 'createdAt']) &&
        incoming().uid == request.auth.uid &&
        incoming().profileId is string && incoming().profileId.size() >= 1 && incoming().profileId.size() <= 64 &&
        incoming().createdAt == request.time;
      allow delete: if false;
    }

      // 6. Konta login + hasło: pełny profil gracza, widoczny tylko dla właściciela.
    match /accounts/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isSignedIn() && request.auth.uid == uid &&
        incoming().keys().hasAll(['uid', 'login', 'profile', 'updatedAt']) &&
        incoming().keys().hasOnly(['uid', 'login', 'profile', 'updatedAt']) &&
        incoming().uid == uid &&
        incoming().login is string && incoming().login.size() >= 1 && incoming().login.size() <= 32 &&
        incoming().profile is map &&
        incoming().updatedAt == request.time &&
        reviewState(uid) != 'suspended';
      allow delete: if isSignedIn() && request.auth.uid == uid;

      // Pełna historia serii: jeden dokument na miesiąc (krótkie podsumowania, bez zadań).
      match /history/{month} {
        allow get, list: if isSignedIn() && (request.auth.uid == uid || isAdmin());
        allow create, update: if isSignedIn() && request.auth.uid == uid &&
          month.matches('^[0-9]{4}-[0-9]{2}$') &&
          incoming().keys().hasOnly(['items', 'updatedAt']) &&
          incoming().items is list && incoming().items.size() <= 3000 &&
          incoming().updatedAt == request.time &&
          reviewState(uid) != 'suspended';
        allow delete: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // 7. Grupy (rodzina, znajomi…) — wyniki widzą tylko członkowie danej grupy.
    function isCircleMember(circleId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid));
    }

    function isValidCircleName(name) {
      return name is string && name.size() >= 1 && name.size() <= 40;
    }

    match /circleCodes/{code} {
      allow get: if isSignedIn() && isValidJoinCodeId(code);
      allow list: if false;
      allow create: if isSignedIn() && isValidJoinCodeId(code) &&
        incoming().keys().hasAll(['circleId', 'createdAt']) &&
        incoming().keys().hasOnly(['circleId', 'createdAt']) &&
        isValidId(incoming().circleId) &&
        getAfter(/databases/$(database)/documents/circles/$(incoming().circleId)).data.ownerUid == request.auth.uid &&
        getAfter(/databases/$(database)/documents/circles/$(incoming().circleId)).data.joinCode == code &&
        incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    match /circles/{circleId} {
      allow get: if isValidId(circleId) && isCircleMember(circleId);
      allow list: if false;
      allow create: if isSignedIn() && isValidId(circleId) &&
        incoming().keys().hasAll(['name', 'ownerUid', 'joinCode', 'createdAt']) &&
        incoming().keys().hasOnly(['name', 'ownerUid', 'joinCode', 'createdAt']) &&
        incoming().ownerUid == request.auth.uid &&
        isValidCircleName(incoming().name) &&
        isValidJoinCodeId(incoming().joinCode) &&
        getAfter(/databases/$(database)/documents/circleCodes/$(incoming().joinCode)).data.circleId == circleId &&
        incoming().createdAt == request.time;
      allow update: if isSignedIn() && existing().ownerUid == request.auth.uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name']) &&
        isValidCircleName(incoming().name);
      allow delete: if false;

      match /members/{memberUid} {
        allow get, list: if isCircleMember(circleId);
        allow create: if isSignedIn() && memberUid == request.auth.uid &&
          incoming().keys().hasAll(['uid', 'joinCode', 'joinedAt']) &&
          incoming().keys().hasOnly(['uid', 'joinCode', 'joinedAt']) &&
          incoming().uid == memberUid &&
          isValidJoinCodeId(incoming().joinCode) &&
          getAfter(/databases/$(database)/documents/circleCodes/$(incoming().joinCode)).data.circleId == circleId &&
          incoming().joinedAt == request.time;
        allow update: if false;
        allow delete: if isSignedIn() && memberUid == request.auth.uid;
      }

      match /players/{playerUid} {
        allow get, list: if isCircleMember(circleId);
        allow create, update: if isCircleMember(circleId) && playerUid == request.auth.uid &&
          incoming().uid == playerUid &&
          incoming().keys().hasOnly([
            'uid', 'profileId', 'name', 'avatarId', 'customAvatarSpec', 'xp', 'streakDays',
            'solvedTasks', 'accuracyPct', 'avgTimeSec', 'sessionsCount', 'tournamentBests',
            'updatedAtMs', 'updatedAt', 'recentSeries'
          ]) &&
          (!('recentSeries' in incoming()) || (incoming().recentSeries is list && incoming().recentSeries.size() <= 12)) &&
          incoming().name is string && incoming().name.size() >= 1 && incoming().name.size() <= 32 &&
          incoming().xp is number && incoming().xp >= 0 && incoming().xp <= 10000000 &&
          incoming().updatedAt == request.time &&
          !(reviewState(playerUid) in ['pending', 'suspended']);
        allow delete: if isSignedIn() && playerUid == request.auth.uid;
      }
    }
  }
}
