rules_version = '2';

// Reguły bazy projektu „mistrz-tabliczki” (plan Spark, bez opłat).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidJoinCodeId(code) {
      return code is string && code.size() >= 4 && code.size() <= 16 && code.matches('^[A-Z0-9\\-]+$');
    }

    // Administrator (rodzic): konto Google z dokumentem admins/{uid} — nadawanym ręcznie w konsoli.
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{adminUid} {
      allow get: if isSignedIn() && request.auth.uid == adminUid;
      allow list, write: if false;
    }

    // Dziennik prób logowania (bez haseł) — zapis dla każdego, odczyt tylko dla administratora.
    match /loginEvents/{eventId} {
      allow create: if
        incoming().keys().hasAll(['login', 'ok', 'reason', 'device', 'at']) &&
        incoming().keys().hasOnly(['login', 'ok', 'reason', 'device', 'at']) &&
        incoming().login is string && incoming().login.size() <= 40 &&
        incoming().ok is bool &&
        incoming().reason is string && incoming().reason.size() <= 60 &&
        incoming().device is string && incoming().device.size() <= 20 &&
        incoming().at == request.time;
      allow get, list, delete: if isAdmin();
      allow update: if false;
    }

    // 5. Login → identyfikator profilu (potrzebny, by na nowym urządzeniu sprawdzić hasło).
    match /logins/{login} {
      allow get: if login.size() <= 40;
      allow list: if isAdmin();
      allow create: if isSignedIn() && login.size() >= 1 && login.size() <= 40 &&
        incoming().keys().hasAll(['uid', 'profileId', 'createdAt']) &&
        incoming().keys().hasOnly(['uid', 'profileId', 'createdAt']) &&
        incoming().uid == request.auth.uid &&
        incoming().profileId is string && incoming().profileId.size() >= 1 && incoming().profileId.size() <= 64 &&
        incoming().createdAt == request.time;
      allow update: if isSignedIn() && existing().uid == request.auth.uid &&
        incoming().keys().hasOnly(['uid', 'profileId', 'createdAt']) &&
        incoming().uid == request.auth.uid &&
        incoming().profileId is string && incoming().profileId.size() >= 1 && incoming().profileId.size() <= 64 &&
        incoming().createdAt == request.time;
      allow delete: if false;
    }

      // 6. Konta login + hasło: pełny profil gracza, widoczny tylko dla właściciela.
    match /accounts/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isSignedIn() && request.auth.uid == uid &&
        incoming().keys().hasAll(['uid', 'login', 'profile', 'updatedAt']) &&
        incoming().keys().hasOnly(['uid', 'login', 'profile', 'updatedAt']) &&
        incoming().uid == uid &&
        incoming().login is string && incoming().login.size() >= 1 && incoming().login.size() <= 32 &&
        incoming().profile is map &&
        incoming().updatedAt == request.time;
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // 7. Grupy (rodzina, znajomi…) — wyniki widzą tylko członkowie danej grupy.
    function isCircleMember(circleId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid));
    }

    function isValidCircleName(name) {
      return name is string && name.size() >= 1 && name.size() <= 40;
    }

    match /circleCodes/{code} {
      allow get: if isSignedIn() && isValidJoinCodeId(code);
      allow list: if false;
      allow create: if isSignedIn() && isValidJoinCodeId(code) &&
        incoming().keys().hasAll(['circleId', 'createdAt']) &&
        incoming().keys().hasOnly(['circleId', 'createdAt']) &&
        isValidId(incoming().circleId) &&
        getAfter(/databases/$(database)/documents/circles/$(incoming().circleId)).data.ownerUid == request.auth.uid &&
        getAfter(/databases/$(database)/documents/circles/$(incoming().circleId)).data.joinCode == code &&
        incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    match /circles/{circleId} {
      allow get: if isValidId(circleId) && isCircleMember(circleId);
      allow list: if false;
      allow create: if isSignedIn() && isValidId(circleId) &&
        incoming().keys().hasAll(['name', 'ownerUid', 'joinCode', 'createdAt']) &&
        incoming().keys().hasOnly(['name', 'ownerUid', 'joinCode', 'createdAt']) &&
        incoming().ownerUid == request.auth.uid &&
        isValidCircleName(incoming().name) &&
        isValidJoinCodeId(incoming().joinCode) &&
        getAfter(/databases/$(database)/documents/circleCodes/$(incoming().joinCode)).data.circleId == circleId &&
        incoming().createdAt == request.time;
      allow update: if isSignedIn() && existing().ownerUid == request.auth.uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name']) &&
        isValidCircleName(incoming().name);
      allow delete: if false;

      match /members/{memberUid} {
        allow get, list: if isCircleMember(circleId);
        allow create: if isSignedIn() && memberUid == request.auth.uid &&
          incoming().keys().hasAll(['uid', 'joinCode', 'joinedAt']) &&
          incoming().keys().hasOnly(['uid', 'joinCode', 'joinedAt']) &&
          incoming().uid == memberUid &&
          isValidJoinCodeId(incoming().joinCode) &&
          getAfter(/databases/$(database)/documents/circleCodes/$(incoming().joinCode)).data.circleId == circleId &&
          incoming().joinedAt == request.time;
        allow update: if false;
        allow delete: if isSignedIn() && memberUid == request.auth.uid;
      }

      match /players/{playerUid} {
        allow get, list: if isCircleMember(circleId);
        allow create, update: if isCircleMember(circleId) && playerUid == request.auth.uid &&
          incoming().uid == playerUid &&
          incoming().keys().hasOnly([
            'uid', 'profileId', 'name', 'avatarId', 'customAvatarSpec', 'xp', 'streakDays',
            'solvedTasks', 'accuracyPct', 'avgTimeSec', 'sessionsCount', 'tournamentBests',
            'updatedAtMs', 'updatedAt'
          ]) &&
          incoming().name is string && incoming().name.size() >= 1 && incoming().name.size() <= 32 &&
          incoming().xp is number && incoming().xp >= 0 && incoming().xp <= 10000000 &&
          incoming().updatedAt == request.time;
        allow delete: if isSignedIn() && playerUid == request.auth.uid;
      }
    }
  }
}
